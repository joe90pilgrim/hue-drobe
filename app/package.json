{
  "name": "huedrobe-app",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "dev:b": "node scripts/dev-as.mjs b",
    "dev:joe": "node scripts/dev-as.mjs joe",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "icons": "node scripts/make-icons.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run tests",
    "check:assets": "node scripts/check-assets.mjs",
    "check:deploy": "node --test ../deploy/server.test.mjs ../deploy/sync.test.mjs ../deploy/identify.test.mjs",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm run test && npm run check:assets && npm run check:deploy && npm run test:e2e"
  },
  "dependencies": {
    "three": "0.170.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "@types/node": "^22.10.2",
    "@types/three": "0.170.0",
    "typescript": "5.6.3",
    "vite": "6.0.7",
    "vitest": "^2.1.8"
  }
}
